# Local, HDFS, ABFS, or S3-compatible paths all work when Spark is configured.
GHCN_STATIONS=/path/to/ghcnd-stations.txt
GHCN_COUNTRIES=/path/to/ghcnd-countries.txt
GHCN_STATES=/path/to/ghcnd-states.txt
GHCN_INVENTORY=/path/to/ghcnd-inventory.txt
GHCN_DAILY_2024=/path/to/daily/2024.csv.gz
GHCN_DAILY_GLOB=/path/to/daily/*.csv.gz
OUTPUT_DIR=output
